# ============================================================
# PyDistance-Service Configuration
# Copy this file to `.env` and adjust values for your hardware.
# ============================================================

# --- Sensor physical parameters (CHG laser displacement sensor) ---
# Minimum measurable distance (mm)
D_MIN=50.0
# Maximum measurable distance (mm); CHG-1250 -> 2500, CHG-1400 -> 4000
D_MAX=2500.0
# Full-scale output voltage of the sensor (V)
V_MAX=10.0
# Voltage above this value indicates "no valid target" (datasheet: ~10.2V)
V_ERROR=10.1
# Voltage divider compensation ratio (real_v = measured_v * DIVIDER_RATIO)
DIVIDER_RATIO=1.682
# Field calibration: corrected distance = former UI's ADC-derived distance
# display (a) * scale + offset; the result matches the sensor display (o).
DISTANCE_CALIBRATION_SCALE=0.99333765
DISTANCE_CALIBRATION_OFFSET_MM=18.552624

# --- ADS1115 hardware configuration ---
# I2C address (0x48 default, 0x49/0x4A/0x4B by tying ADDR pin)
I2C_ADDRESS=0x48
# The sensor is wired to ADS1115 A1 (API index 1); A0 is unused.
ADS_CHANNELS=[1]
# ADS1115 conversion rate (samples/second)
ADS_DATA_RATE=250

# --- High-frequency sampling + 1-second window filtering ---
# Period of one round (all channels) in seconds. 0.02 -> ~50Hz/channel
SAMPLE_INTERVAL=0.02
# Filter window length in seconds (only samples within this window are used)
WINDOW_SECONDS=1.0
# Filter algorithm: "mean" | "median" | "trimmed_mean"
FILTER_METHOD=trimmed_mean
# Trim ratio for trimmed_mean (both ends), e.g. 0.2 -> drop top/bottom 20%
TRIM_RATIO=0.2
# Distance jump threshold (mm) to log as WARNING (anomaly detection)
ANOMALY_JUMP_MM=50.0

# --- Service configuration ---
HOST=0.0.0.0
PORT=8000
# WebSocket push interval in seconds (~10 updates/s at 0.1)
WS_PUSH_INTERVAL=0.1
LOG_LEVEL=INFO
LOG_FILE=logs/service.log

# --- Robot height calibration ---
# Default: simulator only. Live control requires a broker host and all five
# explicit safety confirmations in the start request. Use a trusted network.
CALIBRATION_DB=data/calibration.sqlite3
CALIBRATION_LIVE_ENABLED=false
# Extra distance added only to no-load (N) calibration measurements. Use 0 to disable.
EMPTY_TEST_SENSOR_OFFSET_MM=3.0
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Optional trusted CA file when MQTT_TLS=true. Leave unset to use system CAs.
# MQTT_CA_FILE=/etc/ssl/certs/plant-mqtt-ca.pem
# Device registry for the online robotSN picker. The selected SN is used
# directly as the MQTT topic identifier.
ROBOT_DEVICE_API_URL=http://10.0.81.109:8787/api/devices
ROBOT_DEVICE_API_TIMEOUT_SECONDS=5
